//@theme "/dev/null"

@theme "/usr/share/rofi/themes/Monokai.rasi"
//@theme "/usr/share/rofi/themes/dmenu.rasi"

// Globals
* {
    bordercolor:          rgba ( 0, 0, 0, 0 % );
    background:           rgba ( 0, 0, 0, 80 % );
    text-color:           White;
    font: "Fira Mono Regular 10";
}

window {
  background-color: @background;
  border: 0;
  width: 30%;
}

listview {
  lines: 10;
  dynamic: true;
  expand: false;
  fixed-height: false;
}
// Run Config
configuration {
  run,drun {
    display-name: ">";
  }
}
// This just overwrites the setting in Monokai.rasi
textbox-prompt-colon {
    str:        "";
    margin:     0px 0.3em 0em 0em ;
    text-color: @normal-foreground;
}
